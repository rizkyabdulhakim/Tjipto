# Shared primary: local 9Router (OpenAI-compatible)
TJIPTO_LLM_PROVIDER=openai_compatible
TJIPTO_LLM_API_KEY=replace-with-9router-key
TJIPTO_LLM_MODEL=ag/gemini-3.7-flash-high
TJIPTO_LLM_BASE_URL=http://127.0.0.1:20128/v1
TJIPTO_LLM_TIMEOUT_SECONDS=30

# Optional wording fallback: Gemini OpenAI-compatible endpoint
TJIPTO_WORDING_PROVIDER=openai_compatible
TJIPTO_WORDING_API_KEY=replace-with-gemini-key
TJIPTO_WORDING_MODEL=gemini-3.1-flash-lite
TJIPTO_WORDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
TJIPTO_WORDING_TIMEOUT_SECONDS=30

# Final fallback for planner and wording: Groq OpenAI-compatible endpoint
TJIPTO_FALLBACK_LLM_PROVIDER=openai_compatible
TJIPTO_FALLBACK_LLM_API_KEY=replace-with-groq-key
TJIPTO_FALLBACK_LLM_MODEL=openai/gpt-oss-20b
TJIPTO_FALLBACK_LLM_BASE_URL=https://api.groq.com/openai/v1
TJIPTO_FALLBACK_LLM_TIMEOUT_SECONDS=30
